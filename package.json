{
  "name": "ar-fight",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile AR: draw a weapon mid-air, classify it as a gun or melee weapon, tag its muzzle/trigger/grip or grip/strike edge, then wield it. Stereo passthrough for a phone-in-headset, hand tracking from the rear camera.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "serve": "node tools/serve.js",
    "serve:http": "node tools/serve.js --http",
    "fetch-deps": "node tools/fetch-deps.js",
    "check": "node --experimental-vm-modules --no-warnings tools/check.js",
    "test": "node --import ./tools/three-loader.js tools/test.js",
    "smoke": "node tools/smoke.js",
    "smoke:shots": "node tools/smoke.js --shots",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "optionalDependencies": {
    "playwright": "^1.62.0"
  }
}
